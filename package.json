{
  "name": "gitiq",
  "displayName": "GitIQ",
  "description": "AI-Powered Git Assistant for Visual Studio Code",
  "version": "1.1.3",
  "publisher": "gitiq",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "git",
    "github",
    "commit",
    "commit message",
    "pull request",
    "git assistant",
    "ai",
    "groq",
    "developer",
    "vscode",
    "productivity",
    "git history",
    "repository",
    "branch",
    "merge",
    "code review"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ThakurDivyanshsingh-77/CommitPilot-AI.git"
  },
  "homepage": "https://github.com/ThakurDivyanshsingh-77/CommitPilot-AI#readme",
  "bugs": {
    "url": "https://github.com/ThakurDivyanshsingh-77/CommitPilot-AI/issues"
  },
  "activationEvents": [
    "onView:gitiq.sidebarView",
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitIQ.hello",
        "title": "Hello",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.checkGitRepository",
        "title": "Check Git Repository",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.previewGitDiff",
        "title": "Preview Git Diff",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.viewCommitHistory",
        "title": "View Commit History",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.explainCommit",
        "title": "Explain Commit",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyCommitHash",
        "title": "Copy Commit Hash",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.push",
        "title": "Push Branch",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.pull",
        "title": "Pull Branch",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.fetch",
        "title": "Fetch Updates",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.currentBranch",
        "title": "Show Current Branch",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.repositoryInfo",
        "title": "Repository Information",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.openRepository",
        "title": "Open GitHub Repository",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.openBranch",
        "title": "Open Current Branch on GitHub",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.generatePullRequest",
        "title": "Generate Pull Request",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyPRTitle",
        "title": "Copy PR Title",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyPRDescription",
        "title": "Copy PR Description",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyEntirePullRequest",
        "title": "Copy Entire Pull Request",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.savePullRequest",
        "title": "Save Pull Request",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.openPullRequestPage",
        "title": "Open Pull Request Page",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.searchCommitHistory",
        "title": "Search Commit History",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.commitStatistics",
        "title": "Commit Statistics",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.topContributors",
        "title": "Top Contributors",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.commitActivity",
        "title": "Commit Activity",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.exportHistoryReport",
        "title": "Export History Report",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.setApiKey",
        "title": "Set Groq API Key",
        "category": "GitIQ",
        "icon": "$(key)"
      },
      {
        "command": "gitIQ.updateApiKey",
        "title": "Update Groq API Key",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.removeApiKey",
        "title": "Remove Groq API Key",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.selectModel",
        "title": "Select Groq Model",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.selectProvider",
        "title": "Select AI Provider",
        "category": "GitIQ",
        "icon": "$(hub)"
      },
      {
        "command": "gitIQ.setGeminiApiKey",
        "title": "Set Google Gemini API Key",
        "category": "GitIQ",
        "icon": "$(key)"
      },
      {
        "command": "gitIQ.refreshSidebar",
        "title": "Refresh Dashboard",
        "category": "GitIQ",
        "icon": "$(refresh)"
      },
      {
        "command": "gitIQ.aiCodeReview",
        "title": "AI Code Review",
        "category": "GitIQ",
        "icon": "$(shield)"
      },
      {
        "command": "gitIQ.showCodeReviewReport",
        "title": "Show Code Review Report",
        "category": "GitIQ",
        "icon": "$(book)"
      },
      {
        "command": "gitIQ.selectRepository",
        "title": "Select Git Repository",
        "category": "GitIQ",
        "icon": "$(repo)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitiq-sidebar",
          "title": "GitIQ",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "gitiq-sidebar": [
        {
          "type": "webview",
          "id": "gitiq.sidebarView",
          "name": "Dashboard",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitiq.sidebarView",
        "contents": "No folder is currently open in VS Code.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == 'empty'"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitIQ.setApiKey",
          "when": "view == gitiq.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "gitIQ.refreshSidebar",
          "when": "view == gitiq.sidebarView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "GitIQ",
      "properties": {
        "gitIQ.apiKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Groq API key used only when generating a commit-message suggestion or explaining commits."
        },
        "gitIQ.provider": {
          "type": "string",
          "default": "groq",
          "enum": [
            "groq",
            "copilot",
            "gemini",
            "ollama",
            "mcp",
            "openai"
          ],
          "scope": "window",
          "description": "AI provider used for suggestions. Options: groq, copilot, gemini, ollama, mcp, openai."
        },
        "gitIQ.geminiApiKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Google Gemini API key used when Gemini provider is selected. Store securely via command: `GitIQ: Set Gemini API Key`."
        },
        "gitIQ.geminiModel": {
          "type": "string",
          "default": "gemini-1.5-flash",
          "enum": [
            "gemini-1.5-flash",
            "gemini-1.5-pro",
            "gemini-2.0-flash"
          ],
          "scope": "window",
          "description": "Model identifier used when Google Gemini provider is selected."
        },
        "gitIQ.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "scope": "window",
          "description": "Custom API endpoint URL for local Ollama server."
        },
        "gitIQ.model": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "scope": "window",
          "description": "Model identifier used to generate commit-message suggestions."
        },
        "gitIQ.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "scope": "window",
          "description": "Sampling temperature for generated commit-message suggestions."
        },
        "gitIQ.timeout": {
          "type": "number",
          "default": 30000,
          "minimum": 1,
          "scope": "window",
          "description": "AI request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./ && npm run build",
    "watch": "tsc -watch -p ./",
    "build:ext": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build:mcp": "esbuild ./src/mcp/server.ts --bundle --outfile=out/mcp/server.js --format=cjs --platform=node",
    "build": "npm run build:ext && npm run build:mcp",
    "package:ext": "esbuild ./src/extension.ts --bundle --minify --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "package:mcp": "esbuild ./src/mcp/server.ts --bundle --minify --outfile=out/mcp/server.js --format=cjs --platform=node",
    "package": "npm run package:ext && npm run package:mcp",
    "lint": "eslint src --ext ts",
    "test": "node --test test/*.test.cjs",
    "mcp": "node ./out/mcp/server.js",
    "check": "npm run compile && npm run lint && npm run test && npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "groq-sdk": "^1.5.0"
  }
}
