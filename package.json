{
  "name": "gitiq",
  "displayName": "GitIQ",
  "description": "AI-Powered Git Assistant for Visual Studio Code",
  "version": "1.0.2",
  "publisher": "gitiq",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "git",
    "github",
    "commit",
    "commit message",
    "pull request",
    "git assistant",
    "ai",
    "groq",
    "developer",
    "vscode",
    "productivity",
    "git history",
    "repository",
    "branch",
    "merge",
    "code review"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ThakurDivyanshsingh-77/CommitPilot-AI.git"
  },
  "homepage": "https://github.com/ThakurDivyanshsingh-77/CommitPilot-AI#readme",
  "bugs": {
    "url": "https://github.com/ThakurDivyanshsingh-77/CommitPilot-AI/issues"
  },
  "activationEvents": [
    "onCommand:gitIQ.hello",
    "onCommand:gitIQ.checkGitRepository",
    "onCommand:gitIQ.previewGitDiff",
    "onCommand:gitIQ.generateCommitMessage",
    "onCommand:gitIQ.viewCommitHistory",
    "onCommand:gitIQ.explainCommit",
    "onCommand:gitIQ.copyCommitHash",
    "onCommand:gitIQ.push",
    "onCommand:gitIQ.pull",
    "onCommand:gitIQ.fetch",
    "onCommand:gitIQ.currentBranch",
    "onCommand:gitIQ.repositoryInfo",
    "onCommand:gitIQ.openRepository",
    "onCommand:gitIQ.openBranch",
    "onCommand:gitIQ.generatePullRequest",
    "onCommand:gitIQ.copyPRTitle",
    "onCommand:gitIQ.copyPRDescription",
    "onCommand:gitIQ.copyEntirePullRequest",
    "onCommand:gitIQ.savePullRequest",
    "onCommand:gitIQ.openPullRequestPage",
    "onCommand:gitIQ.searchCommitHistory",
    "onCommand:gitIQ.commitStatistics",
    "onCommand:gitIQ.topContributors",
    "onCommand:gitIQ.commitActivity",
    "onCommand:gitIQ.exportHistoryReport",
    "onCommand:gitIQ.setApiKey",
    "onCommand:gitIQ.updateApiKey",
    "onCommand:gitIQ.removeApiKey",
    "onCommand:gitIQ.selectModel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitIQ.hello",
        "title": "Hello",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.checkGitRepository",
        "title": "Check Git Repository",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.previewGitDiff",
        "title": "Preview Git Diff",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.viewCommitHistory",
        "title": "View Commit History",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.explainCommit",
        "title": "Explain Commit",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyCommitHash",
        "title": "Copy Commit Hash",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.push",
        "title": "Push Branch",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.pull",
        "title": "Pull Branch",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.fetch",
        "title": "Fetch Updates",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.currentBranch",
        "title": "Show Current Branch",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.repositoryInfo",
        "title": "Repository Information",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.openRepository",
        "title": "Open GitHub Repository",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.openBranch",
        "title": "Open Current Branch on GitHub",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.generatePullRequest",
        "title": "Generate Pull Request",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyPRTitle",
        "title": "Copy PR Title",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyPRDescription",
        "title": "Copy PR Description",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.copyEntirePullRequest",
        "title": "Copy Entire Pull Request",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.savePullRequest",
        "title": "Save Pull Request",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.openPullRequestPage",
        "title": "Open Pull Request Page",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.searchCommitHistory",
        "title": "Search Commit History",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.commitStatistics",
        "title": "Commit Statistics",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.topContributors",
        "title": "Top Contributors",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.commitActivity",
        "title": "Commit Activity",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.exportHistoryReport",
        "title": "Export History Report",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.setApiKey",
        "title": "Set Groq API Key",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.updateApiKey",
        "title": "Update Groq API Key",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.removeApiKey",
        "title": "Remove Groq API Key",
        "category": "GitIQ"
      },
      {
        "command": "gitIQ.selectModel",
        "title": "Select Groq Model",
        "category": "GitIQ"
      }
    ],
    "configuration": {
      "title": "GitIQ",
      "properties": {
        "gitIQ.apiKey": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Groq API key used only when generating a commit-message suggestion or explaining commits."
        },
        "gitIQ.provider": {
          "type": "string",
          "default": "groq",
          "enum": [
            "groq",
            "openai",
            "gemini",
            "ollama"
          ],
          "scope": "window",
          "description": "AI provider used for commit-message suggestions. Only Groq is currently available."
        },
        "gitIQ.model": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "scope": "window",
          "description": "Groq model identifier used to generate commit-message suggestions."
        },
        "gitIQ.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "scope": "window",
          "description": "Sampling temperature for generated commit-message suggestions."
        },
        "gitIQ.timeout": {
          "type": "number",
          "default": 30000,
          "minimum": 1,
          "scope": "window",
          "description": "Groq request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "package": "esbuild ./src/extension.ts --bundle --minify --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "lint": "eslint src --ext ts",
    "check": "npm run compile && npm run lint && npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "groq-sdk": "^1.5.0"
  }
}
